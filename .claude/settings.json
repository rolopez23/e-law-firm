{
  "permissions": {
    "ask": [
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/.next/**)",
      "Read(**/__pycache__/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)"
    ]
  }
}
